MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_SECRET=replace-with-a-different-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional — leave blank to run with mailer disabled (logs a warning instead of sending)
SUPER_ADMIN_EMAIL=
SMTP_USER=
SMTP_PASS=

# Optional — used only by `npm run seed:admin`. Leave blank to auto-generate a
# username/password for the first super admin (printed once to the console).
ADMIN_SEED_EMAIL=
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# Optional — share this code with anyone who should be able to self-register an
# event_admin account at /admin/signup. Leave blank to disable signup entirely.
ADMIN_SIGNUP_CODE=

# Optional — Meta Graph API credentials for auto-pulling Instagram/Facebook posts into
# Announcements. Requires a Meta developer app with an approved Instagram Business/Facebook
# Page access token. Leave META_ACCESS_TOKEN blank to disable auto-pull entirely.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
